{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Director",
  "version": "0.1.0",
  "identifier": "dev.aidirector.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../../bootstrap.py": "bootstrap.py",
      "../../../pyproject.toml": "app/pyproject.toml",
      "../../../uv.lock": "app/uv.lock",
      "../../../src": "app/src",
      "../../../config": "app/config",
      "../../../assets": "app/assets",
      "../../../README.md": "app/README.md"
    }
  }
}
